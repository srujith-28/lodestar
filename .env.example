# Local application settings
APP_NAME=Lodestar API
APP_ENV=development
# Local development only; production requires a PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./lodestar.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Private password access. Both values are needed for the private workspace.
# Password must be at least 12 characters; session secret must be at least 32 characters.
LODESTAR_AUTH_PASSWORD=
LODESTAR_SESSION_SECRET=
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Add only exact reverse-proxy CIDRs whose X-Forwarded-For header is sanitized by the proxy.
TRUSTED_PROXY_CIDRS=

# Public judge preview. Guest data is isolated per browser session and can be reset.
GUEST_DEMO_ENABLED=true
GUEST_SESSION_RATE_LIMIT_MAX_ATTEMPTS=40
GUEST_DATA_RETENTION_DAYS=7
GUEST_API_RATE_LIMIT_MAX_REQUESTS=120
GUEST_API_RATE_LIMIT_WINDOW_SECONDS=60
GUEST_PROVIDER_CALLS_PER_WORKSPACE_PER_DAY=8
GUEST_PROVIDER_CALLS_GLOBAL_PER_DAY=40

# Nebius Token Factory: add a real key when account access is ready.
# This public Nemotron ID is listed in Nebius's current Token Factory catalog.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_ID=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=30
NEBIUS_CONNECT_TIMEOUT_SECONDS=10

# Tavily remains a placeholder; no requests are made in this milestone.
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=
